---
---

<section class="code-preview" id="lms" data-scroll-offset="-190">
  <div class="container">
    <div class="grid">
      <div class="content">
        <h2>Modern Tools for Modern Developers</h2>
        <p>Our curriculum is built around the latest technology stacks. Learn by building real-world applications with clean, scalable code.</p>
        <ul class="feature-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"/></svg>
            Clean Code Best Practices
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"/></svg>
            Scalable Architecture
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"/></svg>
            Industry Standards
          </li>
        </ul>
      </div>
      
      <div class="editor-window">
        <div class="editor-header">
          <div class="dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <a
          href="https://www.nextcareerlabs.online/"
          class="tab"
        >
          Skill Force Cloud LMS
        </a>

        </div>
        <div class="editor-body">
          <img src="/programs/lms.jpg" alt="LMS Dashboard Preview" style="width: 100%; height: auto; display: block; border-radius: 0.5rem;" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .code-preview {
    padding: 8rem 0;
    background-color: #fff;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  p {
    font-size: 1.125rem;
    color: var(--text-main);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--text-dark);
  }

  .check {
    color: #10b981;
  }

  .editor-window {
    background-color: #1e1e1e;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

.editor-header {
  background: rgba(5, 5, 5, 0.55); /* translucent */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  padding: 0.5rem 1rem;
  display: flex;
  align-items: center;
  gap: 1rem;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}


  .dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .red { background-color: #ff5f56; }
  .yellow { background-color: #ffbd2e; }
  .green { background-color: #27c93f; }

 .tab {
  color: #a1a1aa;
  text-decoration: none;
  cursor: pointer;
  transition: color 0.2s ease;
  font-size: 0.7rem;
}

.tab:hover {
  color: #fff;
}

  .editor-body {
    
    font-family: 'Fira Code', 'Courier New', Courier, monospace;
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .keyword { color: #c678dd; }
  .function { color: #61afef; }
  .string { color: #98c379; }
  .tag { color: #e06c75; }
  .attr { color: #d19a66; }

  pre { color: #abb2bf; }

  @media (max-width: 992px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
    .feature-list {
      align-items: center;
      margin-bottom: 3rem;
    }
  }
</style>
