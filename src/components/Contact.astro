    .contact {
      padding: 0 0 4rem 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    
    .contact-info {
      text-align: center;
    }
    
    .info-items {
      align-items: start;
    }

    .info-item {
      flex-direction: row;
      text-align: center;
      gap: 0.75rem;
    }

    .info-item .label {
      display: none;
    }
    .wrapper-info{
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
