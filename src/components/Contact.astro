---
---

<section class="contact" id="contact" data-scroll-offset="-190">
  <div class="container">
    <div class="grid">
      <div class="contact-info">
        <h2>Start Your Journey Today</h2>
        <p>Ready to level up your career? Fill out the form and our admissions team will get back to you within 24 hours.</p>
        
        <div class="info-items">
          <div class="info-item">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="label">Call Us</span>
              <span class="value">+91 98765 43210</span>
            </div>
          </div>
          <div class="info-item">
            <div class="icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <span class="label">Email</span>
              <span class="value">admissions@skillforcecloud.com</span>
            </div>
          </div>
        </div>
      </div>

      <div class="form-container">
        <form class="contact-form" id="contactForm">
          <div id="formMessage" class="form-message"></div>
          <div class="form-grid">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="John Doe" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required />
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required />
            </div>
            <div class="form-group">
              <label for="program-input">Program Interested In</label>
              <div class="custom-select" id="program-select">
                <button type="button" class="select-trigger">
                  <span class="selected-text">Select a program</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="options-container">
                  <div class="option" data-value="devops">DevOps Training</div>
                  <div class="option" data-value="react-native">React Native with MERN</div>
                  <div class="option" data-value="salesforce">Salesforce Training</div>
                </div>
                <input type="hidden" name="program" id="program-input" required />
              </div>
            </div>
            <div class="form-group">
              <label for="passout-input">Passout Year</label>
              <div class="custom-select" id="passout-select">
                <button type="button" class="select-trigger">
                  <span class="selected-text">Select year</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="options-container">
                  <div class="option" data-value="2024">2024</div>
                  <div class="option" data-value="2023">2023</div>
                  <div class="option" data-value="2022">2022</div>
                  <div class="option" data-value="before-2022">Before 2022</div>
                </div>
                <input type="hidden" name="passout" id="passout-input" required />
              </div>
            </div>
            <div class="form-group">
              <label for="resume">Upload Resume (PDF)</label>
              <div class="file-input-wrapper">
                <input type="file" id="resume" name="resume" accept=".pdf" required />
                <span class="file-custom"></span>
              </div>
            </div>
          </div>
          <div class="form-group full-width">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" rows="4" placeholder="Tell us about your career goals..."></textarea>
          </div>
          <button type="submit" class="submit-btn" id="submitBtn">
            <span class="btn-text">Send Application</span>
            <span class="btn-loading" style="display: none;">Sending...</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const customSelects = document.querySelectorAll('.custom-select');

    customSelects.forEach(select => {
      const trigger = select.querySelector('.select-trigger');
      const optionsContainer = select.querySelector('.options-container');
      const hiddenInput = select.querySelector('input[type="hidden"]');
      const options = select.querySelectorAll('.option');
      const selectedText = select.querySelector('.selected-text');
      const chevron = select.querySelector('.chevron');

      if (!trigger || !optionsContainer || !hiddenInput || !selectedText || !chevron) return;

      // Toggle dropdown
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = optionsContainer.classList.contains('active');
        
        // Close all other dropdowns
        document.querySelectorAll('.options-container').forEach(c => {
          if (c !== optionsContainer) {
             c.classList.remove('active');
             c.previousElementSibling?.querySelector('.chevron')?.classList.remove('rotate');
          }
        });

        // Toggle current
        optionsContainer.classList.toggle('active');
        chevron.classList.toggle('rotate');
      });

      // Select option
      options.forEach(option => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = option.getAttribute('data-value');
          const text = option.textContent;

          if (hiddenInput instanceof HTMLInputElement) {
             hiddenInput.value = value || '';
          }
          if (selectedText instanceof HTMLElement) {
             selectedText.textContent = text;
             selectedText.style.color = 'var(--text-dark)';
          }

          options.forEach(o => o.classList.remove('selected'));
          option.classList.add('selected');

          optionsContainer.classList.remove('active');
          chevron.classList.remove('rotate');
        });
      });
    });

    // Close on outside click
    document.addEventListener('click', () => {
      document.querySelectorAll('.options-container').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.chevron').forEach(c => c.classList.remove('rotate'));
    });
  });
</script>

<script>
  // Handle contact form submission
  const contactForm = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = submitBtn.querySelector('.btn-text') as HTMLSpanElement;
  const btnLoading = submitBtn.querySelector('.btn-loading') as HTMLSpanElement;
  const formMessage = document.getElementById('formMessage') as HTMLDivElement;
  const resumeInput = document.getElementById('resume') as HTMLInputElement;

  const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB

  contactForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Clear previous messages
    formMessage.textContent = '';
    formMessage.className = 'form-message';

    // Validate resume file size
    if (resumeInput.files && resumeInput.files[0]) {
      const file = resumeInput.files[0];
      if (file.size > MAX_FILE_SIZE) {
        formMessage.textContent = 'Resume file size must be less than 5MB';
        formMessage.classList.add('error');
        return;
      }
    }
    
    // Show loading state
    submitBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoading.style.display = 'inline';
    
    try {
      const formData = new FormData(contactForm);
      
      const response = await fetch('/api/contact.json', {
        method: 'POST',
        body: formData
      });
      
      const data = await response.json();
      
      if (data.success) {
        formMessage.textContent = 'Thank you! Your application has been submitted successfully. We\'ll get back to you within 24 hours.';
        formMessage.classList.add('success');
        contactForm.reset();
        
        // Reset custom selects
        document.querySelectorAll('.selected-text').forEach(el => {
          if (el instanceof HTMLElement) {
            el.textContent = el.closest('.custom-select')?.id === 'program-select' ? 'Select a program' : 'Select year';
            el.style.color = '#9ca3af';
          }
        });
      } else {
        formMessage.textContent = data.error || 'Something went wrong. Please try again.';
        formMessage.classList.add('error');
      }
    } catch (error) {
      formMessage.textContent = 'Network error. Please check your connection and try again.';
      formMessage.classList.add('error');
    } finally {
      // Reset loading state
      submitBtn.disabled = false;
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
    }
  });
</script>

<style>
  .contact {
    padding: 0 0 8rem 0;
    background-color: #f9fafb;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: flex-start;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
  }

  p {
    font-size: 1.125rem;
    color: var(--text-main);
    margin-bottom: 3rem;
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .icon-circle {
    width: 44px;
    height: 44px;
    background-color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .value {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .form-container {
    background: white;
    padding: 3rem;
    border-radius: 1.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .form-message {
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    display: none;
  }

  .form-message.success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
    display: block;
  }

  .form-message.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
    display: block;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .full-width {
    grid-column: span 2;
  }

  label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  input, select, textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, ring 0.2s;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--primary);
    ring: 2px solid rgba(79, 70, 229, 0.1);
  }

  /* Custom Select Styles */
  .custom-select {
    position: relative;
    width: 100%;
  }

  .select-trigger {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 1rem;
    color: #9ca3af; /* Placeholder color */
    text-align: left;
  }

  .select-trigger:hover {
    border-color: var(--primary);
  }

  .selected-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chevron {
    color: #6b7280;
    transition: transform 0.2s;
  }

  .chevron.rotate {
    transform: rotate(180deg);
  }

  .options-container {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 100%;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    max-height: 250px;
    overflow-y: auto;
  }

  .options-container.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .option {
    padding: 0.75rem 1rem;
    cursor: pointer;
    color: var(--text-dark);
    transition: background-color 0.1s;
  }

  .option:hover {
    background-color: #f3f4f6;
    color: var(--primary);
  }

  .option.selected {
    background-color: #eff6ff;
    color: var(--primary);
    font-weight: 600;
  }

  /* End Custom Select */

  /* Original textarea styles */
  textarea {
    resize: none;
  }

  .file-input-wrapper input[type="file"] {
    width: 100%;
    color: var(--text-main);
    padding: 0.5rem;
    background: #fff;
  }

  .file-input-wrapper input[type="file"]::file-selector-button {
    margin-right: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background-color: var(--primary);
    color: white;
    border: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .file-input-wrapper input[type="file"]::file-selector-button:hover {
    filter: brightness(0.9);
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background-color: var(--primary);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
  }

  .submit-btn:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  @media (max-width: 992px) {
    .grid {
      grid-template-columns: 1fr;
    }
    
    .contact-info {
      text-align: center;
    }
    
    .info-items {
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    
    .full-width {
      grid-column: span 1;
    }
    
    .form-container {
      padding: 2rem 1.5rem;
    }
  }
</style>
