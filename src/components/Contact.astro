    margin-bottom: 0.75rem;
  }

  .modal-content p {
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .btn-retry {
    width: 100%;
    padding: 0.875rem;
    background: #ef4444;
