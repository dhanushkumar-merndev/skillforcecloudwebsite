---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo">
          <img src="/logo.svg" alt="Skill Force Cloud Logo" width="75" height="75" class="logo-img" />
          <img src="/text.svg" alt="Skill Force Cloud" height="24" class="logo-text-img" />
        </div>
        <p>Empowering the next generation of tech leaders with industry-aligned training and guaranteed placement support.</p>
        <div class="social-links">
          <a href="#" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h3>Programs</h3>
        <ul>
          <li><a href="#">DevOps Training</a></li>
          <li><a href="#">React Native with MERN</a></li>
          <li><a href="#">Salesforce Training</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3>Company</h3>
        <ul>
          <li><a href="#">About Us</a></li>
          <li><a href="#">Success Stories</a></li>
          <li><a href="#">Placements</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3>Legal</h3>
        <ul>
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Terms of Service</a></li>
          <li><a href="#">Cookie Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Skill Force Cloud. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #fff;
    color: var(--text-dark);
    padding: 5rem 0 2rem 0;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 -10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  .container {
   
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    white-space: nowrap;
  }

  .logo-text-img {
    height: 24px;
    width: auto;
    
  }

  .footer-brand p {
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    color: var(--text-main);
    transition: color 0.2s;
  }

  .social-links a:hover {
    color: var(--primary);
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-dark);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  ul li {
    margin-bottom: 1rem;
  }

  ul li a {
    color: var(--text-main);
    transition: color 0.2s;
    position: relative;
    text-decoration: none;
    padding-bottom: 2px;
    font-size: 0.95rem;
  }

  ul li a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--primary);
    transition: width 0.3s ease;
  }

  ul li a:hover {
    color: var(--primary);
  }

  ul li a:hover::after {
    width: 100%;
  }

  .footer-bottom {
    border-top: 1px solid #e5e7eb;
    padding-top: 2rem;
    text-align: center;
    color: var(--text-main);
    font-size: 0.875rem;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
