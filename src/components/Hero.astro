---
---

<section class="hero">
  <div class="background-overlay">
    <div class="shape square"></div>
    <div class="shape circle"></div>
    <div class="shape triangle"></div>
    <div class="shape rectangle"></div>
    <div class="shape circle-small"></div>
  </div>
  
  <div class="container">
    <div class="content">
      <h1>Advance Your Career with Skill Force Cloud</h1>
      <p>Professional training programs in DevOps, React Native with MERN, and Salesforce with guaranteed placement support.</p>
      
      <div class="ctas">
        <a href="#programs" class="btn btn-primary">Explore Programs</a>
        <a href="#contact" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 58vh;
    padding: 0;
    margin-top: 10vh;
    background-color: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .shape {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(2px);
    border-radius: 4px;
    animation: float 20s infinite linear;
  }

  .square {
    width: 100px;
    height: 100px;
    top: 10%;
    left: 5%;
    animation-duration: 25s;
    animation-delay: 0s;
  }

  .circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    bottom: 15%;
    right: 10%;
    animation-duration: 30s;
    animation-delay: -5s;
  }

  .triangle {
    width: 0;
    height: 0;
    border-left: 60px solid transparent;
    border-right: 60px solid transparent;
    border-bottom: 100px solid rgba(255, 255, 255, 0.05);
    background-color: transparent;
    top: 10%;
    right: 10%;
    animation-duration: 35s;
    animation-delay: -2s;
    transform: rotate(15deg);
  }

  .rectangle {
    width: 120px;
    height: 60px;
    bottom: 25%;
    left: 10%;
    animation-duration: 28s;
    animation-delay: -8s;
  }
  
  .circle-small {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    background-color: rgba(255, 255, 255, 0.03);
    animation-duration: 40s;
  }

  @keyframes float {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(30px, -50px) rotate(10deg);
    }
    66% {
      transform: translate(-20px, 20px) rotate(-5deg);
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .content {
    max-width: 800px;
    text-align: left;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  p {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .ctas {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background-color: white;
    color: var(--primary);
  }

  .btn-primary:hover {
    background-color: #f3f4f6;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .content {
      text-align: center;
    }

    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1.125rem;
    }

    .ctas {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 300px;
    }
    
    .shape {
       opacity: 0.5;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1.25rem;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1rem;
      margin-bottom: 2rem;
    }

    .hero {
      min-height: auto;
      padding: 3rem 0;
    }
  }
</style>
