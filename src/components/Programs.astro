---
const programs = [
  {
    title: "DevOps Training",
    description: "Master CI/CD, Docker, Kubernetes, and cloud infrastructure with hands-on labs.",
    image: "/programs/devops.webp",
    link: "/programs/devops"
  },
  {
    title: "React Native with MERN",
    description: "Build cross-platform mobile apps using React Native.",
    image: "/programs/mern.webp",
    link: "/programs/mern"
  },
  {
    title: "Salesforce Training",
    description: "Expert-led training on Salesforce Admin, Dev, and Lightning Web Components.",
    image: "/programs/saleforce.webp",
    link: "/programs/salesforce"
  },
];
---

<section class="programs" id="programs" data-scroll-offset="-60">
  <div class="container">
    <div class="section-header">
      <h2>Our Training Programs</h2>
      <p>Industry-aligned courses designed to accelerate your career growth with practical skills and real-world experience.</p>
    </div>

    <div class="programs-grid">
      {programs.map((program) => (
        <a href={program.link} class="program-card">
          <div class="image-wrapper">
            <img src={program.image} alt={program.title} />
            <div class="overlay">
              <span>View Course</span>
            </div>
          </div>
          <div class="content">
            <h3>{program.title}</h3>
            <p>{program.description}</p>
            <div class="card-footer">
              <span class="learn-more">Learn More &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .programs {
    padding: 6rem 0;
    background-color: #f9fafb;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem auto;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.25rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--text-main);
    line-height: 1.6;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: stretch;
  }

  .program-card {
    background: white;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .program-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 16/9;
    height: auto;
    position: relative;
    overflow: hidden;
    background-color: #f3f4f6;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .program-card:hover .image-wrapper img {
    transform: scale(1.05);
  }

  .content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .program-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .program-card p {
    font-size: 1rem;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-footer {
    padding-top: 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  .learn-more {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.2s;
  }

  .program-card:hover .learn-more {
    gap: 0.75rem;
  }

  @media (max-width: 992px) {

    .programs {
    padding: 4rem 0;
  }
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .programs-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .image-wrapper {
      height: auto;
      aspect-ratio: 16/9;
    }

    .program-card {
      height: auto;
    }

    .card-footer {
      padding-top: 1rem;
      height: auto;
    }
    
    .content {
      padding: 1.5rem;
      height: auto;
    }
    
    .container {
      padding: 0 1.5rem;
    }
  }
</style>
