---
const stats = [
  { label: "Successful Placements", value: "500+", icon: "graduation" },
  { label: "Expert Instructors", value: "25+", icon: "users" },
  { label: "Industrial Projects", value: "100+", icon: "folder" },
  { label: "Student Satisfaction", value: "98%", icon: "smile" },
];
---

<section class="stats">
  <div class="container">
    <div class="stats-grid">
      {stats.map((stat) => (
        <div class="stat-item">
          <div class="stat-icon">
            {stat.icon === 'graduation' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>}
            {stat.icon === 'users' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13 a4 4 0 0 1 0 7.75"/></svg>}
            {stat.icon === 'folder' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>}
            {stat.icon === 'smile' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>}
          </div>
          <div class="stat-content">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    height: 20vh;
    min-height: 120px;
    padding: 0;
    background: linear-gradient(180deg, var(--primary) 60%, var(--primary) 100%);
    color: white;
    display: flex;
    align-items: center;
    border-top: none;
    box-shadow: inset 0 10px 20px -5px rgba(255, 255, 255, 0.3);
    
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 9rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-icon {
    margin-bottom: 0.25rem;
    color: white;
  }

  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 500;
    opacity: 0.8;
  }

  @media (max-width: 992px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
