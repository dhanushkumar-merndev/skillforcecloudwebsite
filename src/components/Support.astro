---
const supportFeatures = [
  {
    title: "1-on-1 Mentorship",
    description: "Personalized guidance from industry veterans to help you navigate your career path.",
    icon: "user",
  },
  {
    title: "Resume & Portfolio",
    description: "Expert assistance in building ATS-friendly resumes and professional portfolios.",
    icon: "file",
  },
  {
    title: "Mock Interviews",
    description: "Rigorous interview preparation with real-world scenarios and feedback.",
    icon: "message",
  },
  {
    title: "Lifetime Access",
    description: "Get lifetime access to our course materials and community forum.",
    icon: "lock",
  },
];
---

<section class="support" id="placement" data-scroll-offset="-180">
  <div class="container">
    <div class="section-header">
      <h2>Unmatched Support</h2>
      <p>We don't just teach; we empower you with the tools and support needed to succeed.</p>
    </div>

    <div class="support-grid">
      {supportFeatures.map((feature) => (
        <div class="support-item">
          <div class="support-icon">
            {feature.icon === 'user' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>}
            {feature.icon === 'file' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {feature.icon === 'message' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
            {feature.icon === 'lock' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .support {
    padding: 0 0 6rem 0;
    background-color: #f9fafb;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem auto;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.25rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--text-main);
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .support-item {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    border: 1px solid #f3f4f6;
  }

  .support-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .support-icon {
    width: 50px;
    height: 50px;
    background-color: #eff6ff;
    color: var(--primary);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .support-item h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .support-item p {
    font-size: 0.95rem;
    color: var(--text-main);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .support-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
