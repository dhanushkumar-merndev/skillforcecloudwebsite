---
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<title>Skill Force Cloud</title>
	</head>
	<body>
		<Header />
		<slot />
		<script>
			import Lenis from 'lenis';
			const lenis = new Lenis();

			function raf(time: number) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}

			requestAnimationFrame(raf);

      // Handle hash on page load
      window.addEventListener('load', () => {
        const hash = window.location.hash;
        if (hash && hash !== '#') {
          // Wait for page to fully render
          setTimeout(() => {
            const targetElement = document.querySelector(hash);
            if (targetElement) {
              const offset = targetElement.getAttribute('data-scroll-offset');
              const offsetValue = offset ? parseInt(offset) : -80;

              // Dispatch navigation start event
              window.dispatchEvent(new Event('navigation-start'));

              lenis.scrollTo(hash, { 
                offset: offsetValue,
                immediate: false,
                onComplete: () => {
                  setTimeout(() => {
                    window.dispatchEvent(new Event('navigation-end'));
                  }, 100);
                }
              });
            }
          }, 100);
        }
      });

      // Handle anchor link clicks (both #hash and /#hash formats)
      document.querySelectorAll('a[href*="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLAnchorElement;
          const href = target.getAttribute('href');
          
          if (!href || href === '#') return;

          // Extract the hash portion
          const hashIndex = href.indexOf('#');
          if (hashIndex === -1) return;

          const hash = href.substring(hashIndex);
          const path = href.substring(0, hashIndex);

          // If it's a same-page link (starts with # or is /#)
          if (href.startsWith('#') || (path === '/' && window.location.pathname === '/')) {
            e.preventDefault();
            const targetElement = document.querySelector(hash);
            if (targetElement) {
              const offset = targetElement.getAttribute('data-scroll-offset');
              const offsetValue = offset ? parseInt(offset) : -80;

              // Dispatch navigation start event
              window.dispatchEvent(new Event('navigation-start'));

              lenis.scrollTo(hash, { 
                offset: offsetValue,
                onComplete: () => {
                  // Dispatch navigation end event after scroll completes
                  setTimeout(() => {
                    window.dispatchEvent(new Event('navigation-end'));
                  }, 100);
                }
              });
            }
          }
          // Otherwise let browser handle the cross-page navigation
        });
      });
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #18829c;
		--secondary: #214181;
		--text-main: #374151;
		--text-dark: #111827;
		--bg-white: #ffffff;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family: 'Inter', sans-serif;
		width: 100%;
		height: 100%;
		color: var(--text-main);
		background-color: var(--bg-white);
		scroll-behavior: smooth;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	ul {
		list-style: none;
	}
</style>
