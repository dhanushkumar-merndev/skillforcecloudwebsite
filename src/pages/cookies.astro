---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cookie Policy | Salesforce LMS">
  <main class="legal-page">
    <div class="legal-hero">
      <div class="container text-center">
        <h1 class="page-title">Cookie Policy</h1>
        <p class="last-updated">Last Updated: October 26, 2023</p>
      </div>
    </div>

    <div class="container legal-container">
      <aside class="legal-nav">
        <nav>
          <ul>
            <li><a href="#definition" class="active">Definition</a></li>
            <li><a href="#usage">Why We Use Them</a></li>
            <li><a href="#control">How to Control</a></li>
            <li><a href="#updates">Updates</a></li>
          </ul>
        </nav>
      </aside>

      <div class="legal-content">
        <section id="definition">
          <div class="section-badge">General</div>
          <h2>What are cookies?</h2>
          <p>
            Cookies are small data files that are placed on your computer or mobile device when you visit a website. Cookies are widely used by website owners in order to make their websites work, or to work more efficiently, as well as to provide reporting information. 
            They help us understand how you interact with our platform, allowing us to personalize your learning experience and improve site performance.
          </p>
          <div class="highlight-info">
             <p>This Cookie Policy explains how Salesforce LMS uses cookies and similar technologies (like web beacons and pixels) to recognize you when you visit our website.</p>
          </div>
          <p>
            Cookies set by the website owner (in this case, Salesforce LMS) are called "first-party cookies." Cookies set by parties other than the website owner are called "third-party cookies." Third-party cookies enable third-party features or functionality to be provided on or through the website (e.g., advertising, interactive content, and analytics).
          </p>
        </section>

        <section id="usage">
          <div class="section-badge">Usage</div>
          <h2>Why do we use cookies?</h2>
          <p>We use first and third-party cookies for several reasons. Some cookies are required for technical reasons for our Website to operate, and we refer to these as "essential" or "strictly necessary" cookies. Other cookies also enable us to track and target the interests of our users to enhance the experience on our Online Properties.</p>
          
          <div class="cookie-types">
            <div class="cookie-card">
              <div class="cookie-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h3>Essential</h3>
              <p>These cookies are strictly necessary to provide you with services available through our Website and to use some of its features, such as access to secure areas.</p>
            </div>
            <div class="cookie-card">
              <div class="cookie-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              </div>
              <h3>Analytics</h3>
              <p>These cookies collect information that is used either in aggregate form to help us understand how our Website is being used or how effective our marketing campaigns are.</p>
            </div>
            <div class="cookie-card">
              <div class="cookie-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.72V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.17a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              </div>
              <h3>Functional</h3>
              <p>These cookies are used to enhance the performance and functionality of our Website but are non-essential to their use (e.g., remembering your language or dark mode settings).</p>
            </div>
          </div>
        </section>

        <section id="control">
          <div class="section-badge">Control</div>
          <h2>How can I control cookies?</h2>
          <p>
            You have the right to decide whether to accept or reject cookies. You can exercise your cookie rights by setting your preferences in the Cookie Consent Manager or by changing your browser settings. 
          </p>
          <div class="info-card">
            <div class="info-item">
              <div class="info-text">
                <strong>Browser Settings</strong>
                <p>You can set or amend your web browser controls to accept or refuse cookies. If you choose to reject cookies, you may still use our website though your access to some functionality and areas of our website may be restricted.</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-text">
                <strong>Opting Out</strong>
                <p>Most advertising networks offer you a way to opt out of targeted advertising. If you would like to find out more information, please visit www.aboutads.info/choices/ or www.youronlinechoices.com.</p>
              </div>
            </div>
          </div>
        </section>

        <section id="updates">
          <div class="section-badge">Updates</div>
          <h2>Updates to this Policy</h2>
          <p>
            We may update this Cookie Policy from time to time in order to reflect, for example, changes to the cookies we use or for other operational, legal, or regulatory reasons. 
            Please therefore re-visit this Cookie Policy regularly to stay informed about our use of cookies and related technologies.
          </p>
          <div class="footer-note">
             <p>The date at the top of this Cookie Policy indicates when it was last updated.</p>
             <p>If you have any questions about our use of cookies or other technologies, please email us at support@salesforcelms.com.</p>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --brand-primary: #18829c;
    --brand-light: rgba(24, 130, 156, 0.08);
    --brand-border: rgba(24, 130, 156, 0.2);
    --text-main: #374151;
    --text-dark: #111827;
    --text-muted: #6b7280;
    --white: #ffffff;
    --bg-page: #f9fafb;
    --bg-card: #ffffff;
    --nav-height: 80px;
  }

  .legal-page {
    background-color: var(--bg-page);
    min-height: 100vh;
    padding-bottom: 8rem;
    scroll-behavior: smooth;
  }

  .legal-hero {
    background-color: var(--white);
    padding: 10rem 0 5rem; /* Increased padding */
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 4rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .last-updated {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 0.5rem;
    }
  }

  .legal-container {
    display: grid;
    gap: 4rem;
    margin-top: -3.3rem;
    margin-bottom: -6rem;
  }

  @media (min-width: 992px) {
    .legal-container {
      grid-template-columns: 280px 1fr;
      
    }
  }

  /* Sticky Nav */
  .legal-nav {
    display: none;
  }

  @media (min-width: 992px) {
    .legal-nav {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
      height: fit-content;
      z-index: 10;
    }
  }

  .legal-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid #e5e7eb;
  }

  .legal-nav a {
    display: block;
    padding: 0.85rem 0 0.85rem 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid transparent;
    margin-left: -2px;
  }

  .legal-nav a:hover {
    color: var(--brand-primary);
    background-color: var(--brand-light);
  }

  .legal-nav a.active {
    color: var(--brand-primary);
    border-left-color: var(--brand-primary);
    background: linear-gradient(to right, var(--brand-light), transparent);
  }

  /* Content */
  .legal-content {
    background: var(--bg-card);
    padding: 4rem;
    border-radius: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
  }

  @media (max-width: 768px) {
    .legal-content {
      padding: 2rem 1rem;
      border-radius: 1.5rem;
    }
  }

  section {
    margin-bottom: 5rem; /* Increased spacing */
    scroll-margin-top: calc(var(--nav-height) + 4rem); /* Proper offset for fixed navbar */
  }

  section:last-child {
    margin-bottom: 0;
  }

  .section-badge {
    background: var(--brand-light);
    color: var(--brand-primary);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
    display: inline-block;
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  p {
    line-height: 1.8;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .highlight-info {
    padding: 2rem;
    background-color: var(--bg-page);
    border-radius: 1.25rem;
    border-left: 4px solid var(--brand-primary);
    margin: 2rem 0;
  }

  .highlight-info p {
    margin-bottom: 0;
    font-style: italic;
    font-weight: 500;
  }

  /* Cookie Types Grid */
  .cookie-types {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .cookie-types { grid-template-columns: repeat(3, 1fr); }
  }

  .cookie-card {
    padding: 2rem;
    background: var(--bg-page);
    border-radius: 1.5rem;
    border: 1px solid #e5e7eb;
    text-align: left;
    transition: all 0.3s ease;
  }

  .cookie-card:hover {
    border-color: var(--brand-primary);
    transform: translateY(-5px);
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.1);
  }

  .cookie-icon-wrap {
    width: 3rem;
    height: 3rem;
    background: var(--brand-primary);
    color: white;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 10px rgba(24, 130, 156, 0.3);
  }

  .cookie-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-dark);
  }

  .cookie-card p {
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Info Card Updates */
  .info-card {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .info-item {
    padding: 2rem;
    background: var(--bg-page);
    border-radius: 1.25rem;
    border: 1px solid #e5e7eb;
  }

  .info-text strong {
    display: block;
    font-size: 1.15rem;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .info-text p {
    font-size: 0.95rem;
    margin: 0;
    color: var(--text-main);
  }

  .footer-note {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .footer-note p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .text-center { text-align: center; }

  /* Dark Mode support */
  :global(.dark) {
    --bg-page: #0f172a;
    --white: #1e293b;
    --bg-card: #1e293b;
    --text-dark: #f8fafc;
    --text-main: #cbd5e1;
    --text-muted: #94a3b8;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = Array.from(document.querySelectorAll('section[id]')) as HTMLElement[];
    const navLinks = document.querySelectorAll('.legal-nav a');
    
    if (!sections.length || !navLinks.length) return;

    const updateActiveLink = () => {
      const scrollPos = window.scrollY + 200;
      let activeId = sections[0].id;
      
      for (const section of sections) {
        if (scrollPos >= section.offsetTop) {
          activeId = section.id;
        }
      }

      navLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${activeId}`);
      });
    };

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();

    navLinks.forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (!targetId) return;
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 140;
          const top = (targetElement as HTMLElement).offsetTop - offset;
          
          window.scrollTo({
            top: top,
            behavior: 'smooth'
          });
          
          history.pushState(null, '', targetId);
        }
      });
    });
  });
</script>
