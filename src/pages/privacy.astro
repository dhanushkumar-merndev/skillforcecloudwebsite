---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy | Salesforce LMS">
  <main class="legal-page">
    <div class="legal-hero">
      <div class="container text-center">
        <h1 class="page-title">Privacy Policy</h1>
        <p class="last-updated">Last Updated: October 26, 2023</p>
      </div>
    </div>

    <div class="container legal-container">
      <aside class="legal-nav">
        <nav>
          <ul>
            <li><a href="#overview" class="active">Overview</a></li>
            <li><a href="#collection">1. Information Collection</a></li>
            <li><a href="#usage">2. Use of Information</a></li>
            <li><a href="#disclosure">3. Disclosure</a></li>
            <li><a href="#security">4. Data Security</a></li>
            <li><a href="#contact">5. Contact Us</a></li>
          </ul>
        </nav>
      </aside>

      <div class="legal-content">
        <section id="overview">
          <p class="lead-text">
            At Salesforce LMS, we respect your privacy and are committed to protecting your personal information. 
            This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website 
            and use our services.
          </p>
          <p>
            Your privacy is of the utmost importance to us. We strive to be transparent about the data we collect and how it's used to provide you with the best possible educational experience. By using our platform, you consent to the practices described in this policy.
          </p>
        </section>

        <section id="collection">
          <div class="section-badge">Section 1</div>
          <h2>Information We Collect</h2>
          <p>We collect information that you provide directly to us when you create an account, enroll in a course, or communicate with us. The types of personal information we may collect include:</p>
          
          <div class="info-card">
            <div class="info-item">
              <div class="info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div class="info-text">
                <strong>Personal Data</strong>
                <p>Full name, email address, phone number, shipping address, and professional background details provided during registration.</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M12 18h.01"/><path d="M7 2h10"/></svg>
              </div>
              <div class="info-text">
                <strong>Technical Data</strong>
                <p>IP address, browser type, device information, access times, and pages viewed before and after using our site.</p>
              </div>
            </div>
          </div>

          <p class="mt-4">
            We also use cookies and similar tracking technologies to track the activity on our Service and hold certain information. You can instruct your browser to refuse all cookies or to indicate when a cookie is being sent.
          </p>
        </section>

        <section id="usage">
          <div class="section-badge">Section 2</div>
          <h2>Use of Your Information</h2>
          <p>We use the information we collect to operate, maintain, and provide the features and functionality of our service, including:</p>
          <ul class="custom-list">
            <li>To facilitate account creation and the logon process.</li>
            <li>To send administrative information to you, such as course updates and changes to our terms.</li>
            <li>To process your transactions and manage your enrollments efficiently.</li>
            <li>To provide you with customer support and respond to your inquiries.</li>
            <li>To deliver targeted advertising, newsletters, and other information regarding our programs.</li>
            <li>To monitor and analyze usage and trends to improve your user experience.</li>
          </ul>
        </section>

        <section id="disclosure">
          <div class="section-badge">Section 3</div>
          <h2>Disclosure of Your Information</h2>
          <p>We do not sell your personal data. We may share information we have collected about you in certain situations:</p>
          <div class="disclosure-box">
             <p><strong>Affiliates:</strong> We may share your information with our affiliates, in which case we will require those affiliates to honor this Privacy Policy.</p>
             <p><strong>Service Providers:</strong> We may share your information with third parties that perform services for us or on our behalf, such as payment processing and data analysis.</p>
             <p><strong>Legal Requirements:</strong> We may disclose your information where we believe it is necessary to investigate, prevent, or take action regarding potential violations of our policies, suspected fraud, or as evidence in litigation in which we are involved.</p>
          </div>
        </section>

        <section id="security">
          <div class="section-badge">Section 4</div>
          <h2>Data Security</h2>
          <p>
            We use administrative, technical, and physical security measures to help protect your personal information. While we have taken reasonable steps to secure the personal information you provide to us, please be aware that despite our efforts, no security measures are perfect or impenetrable, and no method of data transmission can be guaranteed against any interception or other type of misuse.
          </p>
          <p>
            Your account is protected by a password for your privacy and security. You must prevent unauthorized access to your account and Personal Information by selecting and protecting your password appropriately.
          </p>
        </section>

        <section id="contact">
          <div class="section-badge">Section 5</div>
          <h2>Contact Us</h2>
          <div class="contact-box">
            <p>If you have questions or comments about this Privacy Policy, please reach out to our dedicated privacy team:</p>
            <a href="mailto:support@salesforcelms.com" class="contact-link">support@salesforcelms.com</a>
            <p class="mt-4 text-sm text-muted">We will respond to your request within 30 days.</p>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --brand-primary: #18829c;
    --brand-light: rgba(24, 130, 156, 0.08);
    --brand-border: rgba(24, 130, 156, 0.2);
    --text-main: #374151;
    --text-dark: #111827;
    --text-muted: #6b7280;
    --white: #ffffff;
    --bg-page: #f9fafb;
    --bg-card: #ffffff;
    --nav-height: 80px;
  }

  .legal-page {
    background-color: var(--bg-page);
    min-height: 100vh;
    padding-bottom: 8rem;
    scroll-behavior: smooth;
  }

  .legal-hero {
    background-color: var(--white);
    padding: 10rem 0 5rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 4rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .last-updated {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 0.5rem;
    }
  }

  .legal-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-top: -3.3rem;
    margin-bottom: -6rem;
  }

  @media (min-width: 992px) {
    .legal-container {
      grid-template-columns: 280px 1fr;
    }
  }

  /* Sticky Nav */
  .legal-nav {
    display: none;
  }

  @media (min-width: 992px) {
    .legal-nav {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
      height: fit-content;
      z-index: 10;
    }
  }

  .legal-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid #e5e7eb;
  }

  .legal-nav a {
    display: block;
    padding: 0.85rem 0 0.85rem 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid transparent;
    margin-left: -2px;
  }

  .legal-nav a:hover {
    color: var(--brand-primary);
    background-color: var(--brand-light);
  }

  .legal-nav a.active {
    color: var(--brand-primary);
    border-left-color: var(--brand-primary);
    background: linear-gradient(to right, var(--brand-light), transparent);
  }

  /* Content */
  .legal-content {
    background: var(--bg-card);
    padding: 4rem;
    border-radius: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
  }

  @media (max-width: 768px) {
    .legal-content {
      padding: 2rem 1.5rem;
      border-radius: 1.5rem;
    }
  }

  section {
    margin-bottom: 5rem;
    scroll-margin-top: calc(var(--nav-height) + 4rem);
  }

  section:last-child {
    margin-bottom: 0;
  }

  .section-badge {
    background: var(--brand-light);
    color: var(--brand-primary);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
    display: inline-block;
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  p {
    line-height: 1.8;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .lead-text {
    font-size: 1.35rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  /* Cards and Boxes */
  .info-card {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .info-card { grid-template-columns: 1fr 1fr; }
  }

  .info-item {
    padding: 2rem;
    border-radius: 1.5rem;
    background: var(--bg-page);
    border: 1px solid #e5e7eb;
    display: flex;
    gap: 1.5rem;
    transition: all 0.3s ease;
  }

  .info-item:hover {
    border-color: var(--brand-primary);
    transform: translateY(-5px);
  }

  .info-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    background: var(--white);
    color: var(--brand-primary);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
  }

  .info-text strong {
    display: block;
    font-size: 1.1rem;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .info-text p {
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
  }

  .custom-list {
    list-style: none;
    padding: 0;
    margin-bottom: 2.5rem;
  }

  .custom-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .custom-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 10px;
    height: 10px;
    background: var(--brand-primary);
    border-radius: 3px;
    opacity: 0.8;
  }

  .disclosure-box, .contact-box {
    padding: 2.5rem;
    background: linear-gradient(135deg, var(--brand-light), transparent);
    border-radius: 1.5rem;
    border-left: 6px solid var(--brand-primary);
    margin: 2rem 0;
  }

  .disclosure-box p {
    margin-bottom: 1.5rem;
  }

  .disclosure-box p:last-child {
    margin-bottom: 0;
  }

  .contact-link {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-primary);
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    border-bottom: 2px solid transparent;
  }

  .contact-link:hover {
    transform: translateX(5px);
    border-bottom-color: var(--brand-primary);
  }

  .mt-4 { margin-top: 1rem; }
  .text-sm { font-size: 0.875rem; }
  .text-center { text-align: center; }

  /* Dark Mode support */
  :global(.dark) {
    --bg-page: #0f172a;
    --white: #1e293b;
    --bg-card: #1e293b;
    --text-dark: #f8fafc;
    --text-main: #cbd5e1;
    --text-muted: #94a3b8;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = Array.from(document.querySelectorAll('section[id]')) as HTMLElement[];
    const navLinks = document.querySelectorAll('.legal-nav a');
    
    if (!sections.length || !navLinks.length) return;

    const updateActiveLink = () => {
      const scrollPos = window.scrollY + 180;
      let activeId = sections[0].id;
      
      for (const section of sections) {
        if (scrollPos >= section.offsetTop) {
          activeId = section.id;
        }
      }

      navLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${activeId}`);
      });
    };

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();

    navLinks.forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const targetId = this.getAttribute('href');
        if (!targetId || !targetId.startsWith('#')) return;
        
        e.preventDefault();
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 120;
          const top = (targetElement as HTMLElement).offsetTop - offset;
          
          window.scrollTo({
            top: top,
            behavior: 'smooth'
          });
          
          history.pushState(null, '', targetId);
        }
      });
    });
  });
</script>
