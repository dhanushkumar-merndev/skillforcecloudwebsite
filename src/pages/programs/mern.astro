---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="program-detail">
    <section class="hero-section">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Home</a> / <a href="/#programs">Programs</a> / <span>React Native with MERN</span>
        </div>
        <h1>React Native + MERN Stack Development</h1>
        <p class="lead">Build powerful mobile and web applications with React Native, MongoDB, Express, React, and Node.js.</p>
        <div class="cta-buttons">
          <a href="/#contact" class="btn btn-primary">Enroll Now</a>
          <a href="#curriculum" class="btn btn-secondary">View Curriculum</a>
        </div>
      </div>
    </section>

    <section class="overview">
      <div class="container">
        <div class="grid-2">
          <div>
            <h2>Program Overview</h2>
            <p>Master the complete MERN stack along with React Native to build scalable full-stack web and mobile applications. This program prepares you for roles as a Full Stack Developer or Mobile App Developer.</p>
            <p>Learn to build production-ready applications from scratch, deploy to cloud platforms, and implement modern development practices.</p>
          </div>
          <div class="highlights">
            <h3>Program Highlights</h3>
            <ul>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> 14-week comprehensive training</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Guaranteed placement support</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="18" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/></svg> Build 5+ mobile apps</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> 10+ full-stack web projects</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Industry expert mentors</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg> AWS deployment training</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="curriculum" id="curriculum">
      <div class="container">
        <h2>Curriculum</h2>
        <div class="modules">
          <div class="module">
            <h3>Module 1: JavaScript Fundamentals</h3>
            <ul>
              <li>ES6+ features and syntax</li>
              <li>Asynchronous JavaScript (Promises, Async/Await)</li>
              <li>Modern JavaScript patterns</li>
              <li>TypeScript basics</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 2: React.js</h3>
            <ul>
              <li>Components and Props</li>
              <li>State and Lifecycle</li>
              <li>Hooks (useState, useEffect, custom hooks)</li>
              <li>Context API and Redux</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 3: Node.js & Express</h3>
            <ul>
              <li>Node.js fundamentals</li>
              <li>Express.js framework</li>
              <li>RESTful API development</li>
              <li>Authentication & Authorization (JWT)</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 4: MongoDB</h3>
            <ul>
              <li>NoSQL database concepts</li>
              <li>Mongoose ODM</li>
              <li>Schema design and relationships</li>
              <li>Database optimization</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 5: React Native</h3>
            <ul>
              <li>Mobile app development basics</li>
              <li>React Native components</li>
              <li>Navigation (React Navigation)</li>
              <li>Native modules and APIs</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 6: Deployment & DevOps</h3>
            <ul>
              <li>Git and version control</li>
              <li>Docker containerization</li>
              <li>AWS/Heroku deployment</li>
              <li>CI/CD pipelines</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>Ready to Build Amazing Apps?</h2>
        <p>Join our proven program and launch your career in full-stack development</p>
        <a href="/#contact" class="btn btn-primary">Apply Now</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .program-detail {
    margin-top: 10vh;
  }

  .hero-section {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    padding: 4rem 0 5rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .breadcrumb a {
    color: white;
    text-decoration: underline;
  }

  .breadcrumb span {
    opacity: 0.7;
  }

  .hero-section h1 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    max-width: 700px;
    color: rgba(255, 255, 255, 0.9);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background-color: white;
    color: var(--primary);
  }

  .btn-primary:hover {
    background-color: #f3f4f6;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .overview {
    padding: 6rem 0;
    background: white;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .highlights {
    background: #f9fafb;
    padding: 2rem;
    border-radius: 1rem;
  }

  .highlights ul {
    list-style: none;
    padding: 0;
  }

  .highlights li {
    padding: 0.75rem 0;
    color: var(--text-dark);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .highlights li svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .curriculum {
    padding: 6rem 0;
    background: #f9fafb;
  }

  .modules {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .module {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
  }

  .module h3 {
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  .module ul {
    list-style: none;
    padding: 0;
  }

  .module li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--text-main);
  }

  .module li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  .cta-section {
    background: var(--primary);
    color: white;
    padding: 5rem 0;
    text-align: center;
  }

  .cta-section h2 {
    color: white;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2rem;
    }

    .grid-2 {
      grid-template-columns: 1fr;
    }

    .modules {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
