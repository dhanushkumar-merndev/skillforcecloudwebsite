---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="program-detail">
    <section class="hero-section">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Home</a> / <a href="/#programs">Programs</a> / <span>Salesforce Training</span>
        </div>
        <h1>Salesforce Administrator & Developer</h1>
        <p class="lead">Become a certified Salesforce professional with hands-on training in administration, development, and cloud solutions.</p>
        <div class="cta-buttons">
          <a href="/#contact" class="btn btn-primary">Enroll Now</a>
          <a href="#curriculum" class="btn btn-secondary">View Curriculum</a>
        </div>
      </div>
    </section>

    <section class="overview">
      <div class="container">
        <div class="grid-2">
          <div>
            <h2>Program Overview</h2>
            <p>Our Salesforce training program covers everything from basic administration to advanced development. Prepare for Salesforce certifications and launch your career in one of the most in-demand cloud platforms.</p>
            <p>Master the Salesforce ecosystem including Sales Cloud, Service Cloud, and the Lightning Platform with real-world projects and scenarios.</p>
          </div>
          <div class="highlights">
            <h3>Program Highlights</h3>
            <ul>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> 10-week intensive program</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> 100% job placement assistance</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg> Salesforce certification prep</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Salesforce-certified trainers</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg> Hands-on Salesforce org access</li>
              <li><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg> 10+ real-world projects</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="curriculum" id="curriculum">
      <div class="container">
        <h2>Curriculum</h2>
        <div class="modules">
          <div class="module">
            <h3>Module 1: Salesforce Basics</h3>
            <ul>
              <li>Salesforce ecosystem overview</li>
              <li>Data model and objects</li>
              <li>User management and security</li>
              <li>Navigation and UI customization</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 2: Administration</h3>
            <ul>
              <li>Custom objects and fields</li>
              <li>Validation rules and formulas</li>
              <li>Workflow rules and Process Builder</li>
              <li>Reports and dashboards</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 3: Apex Programming</h3>
            <ul>
              <li>Apex syntax and data types</li>
              <li>SOQL and SOSL queries</li>
              <li>Triggers and batch processing</li>
              <li>Governor limits and best practices</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 4: Visualforce & Lightning</h3>
            <ul>
              <li>Visualforce pages and components</li>
              <li>Lightning Web Components (LWC)</li>
              <li>Aura components</li>
              <li>Lightning App Builder</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 5: Integration</h3>
            <ul>
              <li>REST and SOAP APIs</li>
              <li>Integration patterns</li>
              <li>Third-party integrations</li>
              <li>Salesforce Connect</li>
            </ul>
          </div>
          <div class="module">
            <h3>Module 6: Certification Prep</h3>
            <ul>
              <li>Admin certification exam prep</li>
              <li>Platform Developer I prep</li>
              <li>Mock exams and practice tests</li>
              <li>Exam strategies and tips</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>Launch Your Salesforce Career</h2>
        <p>Start your journey to becoming a certified Salesforce professional</p>
        <a href="/#contact" class="btn btn-primary">Apply Now</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .program-detail {
    margin-top: 10vh;
  }

  .hero-section {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    padding: 4rem 0 5rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .breadcrumb a {
    color: white;
    text-decoration: underline;
  }

  .breadcrumb span {
    opacity: 0.7;
  }

  .hero-section h1 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    max-width: 700px;
    color: rgba(255, 255, 255, 0.9);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background-color: white;
    color: var(--primary);
  }

  .btn-primary:hover {
    background-color: #f3f4f6;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .overview {
    padding: 6rem 0;
    background: white;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .highlights {
    background: #f9fafb;
    padding: 2rem;
    border-radius: 1rem;
  }

  .highlights ul {
    list-style: none;
    padding: 0;
  }

  .highlights li {
    padding: 0.75rem 0;
    color: var(--text-dark);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .highlights li svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .curriculum {
    padding: 6rem 0;
    background: #f9fafb;
  }

  .modules {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .module {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
  }

  .module h3 {
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  .module ul {
    list-style: none;
    padding: 0;
  }

  .module li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--text-main);
  }

  .module li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  .cta-section {
    background: var(--primary);
    color: white;
    padding: 5rem 0;
    text-align: center;
  }

  .cta-section h2 {
    color: white;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2rem;
    }

    .grid-2 {
      grid-template-columns: 1fr;
    }

    .modules {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
