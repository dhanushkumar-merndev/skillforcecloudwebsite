---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service | Salesforce LMS">
  <main class="legal-page">
    <div class="legal-hero">
      <div class="container text-center">
        <h1 class="page-title">Terms of Service</h1>
        <p class="last-updated">Last Updated: October 26, 2023</p>
      </div>
    </div>

    <div class="container legal-container">
      <aside class="legal-nav">
        <nav>
          <ul>
            <li><a href="#agreement" class="active">1. Agreement</a></li>
            <li><a href="#intellectual">2. Intellectual Property</a></li>
            <li><a href="#representations">3. User Representations</a></li>
            <li><a href="#prohibited">4. Prohibited Activities</a></li>
            <li><a href="#disclaimer">5. Educational Disclaimer</a></li>
            <li><a href="#termination">6. Termination</a></li>
          </ul>
        </nav>
      </aside>

      <div class="legal-content">
        <section id="agreement">
          <div class="section-badge">Section 1</div>
          <h2>Agreement to Terms</h2>
          <p>
            These Terms of Service constitute a legally binding agreement made between you, whether personally or on behalf of an entity ("you") and Salesforce LMS ("we," "us," or "our"), concerning your access to and use of the Salesforce LMS website as well as any other media form, media channel, mobile website or mobile application related, linked, or otherwise connected thereto (collectively, the "Site").
          </p>
          <div class="highlight-info">
            <p>By accessing the Site, you agree that you have read, understood, and agreed to be bound by all of these Terms of Service. If you do not agree with all of these terms, then you are expressly prohibited from using the Site and you must discontinue use immediately.</p>
          </div>
          <p>
            Supplemental terms and conditions or documents that may be posted on the Site from time to time are hereby expressly incorporated herein by reference. We reserve the right, in our sole discretion, to make changes or modifications to these Terms of Service at any time and for any reason.
          </p>
        </section>

        <section id="intellectual">
          <div class="section-badge">Section 2</div>
          <h2>Intellectual Property Rights</h2>
          <p>
             Unless otherwise indicated, the Site is our proprietary property and all source code, databases, functionality, software, website designs, audio, video, text, photographs, and graphics on the Site (collectively, the "Content") and the trademarks, service marks, and logos contained therein (the "Marks") are owned or controlled by us or licensed to us, and are protected by copyright and trademark laws and various other intellectual property rights.
          </p>
          <p>
            The Content and the Marks are provided on the Site "AS IS" for your information and personal use only. Except as expressly provided in these Terms of Service, no part of the Site and no Content or Marks may be copied, reproduced, aggregated, republished, uploaded, posted, publicly displayed, encoded, translated, transmitted, distributed, sold, licensed, or otherwise exploited for any commercial purpose whatsoever, without our express prior written permission.
          </p>
        </section>

        <section id="representations">
          <div class="section-badge">Section 3</div>
          <h2>User Representations</h2>
          <p>By using the Site, you represent and warrant that:</p>
          <ul class="custom-list">
            <li><strong>Accuracy:</strong> All registration information you submit will be true, accurate, current, and complete.</li>
            <li><strong>Maintenance:</strong> You will maintain the accuracy of such information and promptly update such registration information as necessary.</li>
            <li><strong>Legal Capacity:</strong> You have the legal capacity and you agree to comply with these Terms of Service.</li>
            <li><strong>Age Requirement:</strong> You are not a minor in the jurisdiction in which you reside, or if a minor, you have received parental permission to use the Site.</li>
            <li><strong>Compliance:</strong> You will not access the Site through automated or non-human means, whether through a bot, script, or otherwise.</li>
          </ul>
        </section>

        <section id="prohibited">
          <div class="section-badge">Section 4</div>
          <h2>Prohibited Activities</h2>
          <p>
            You may not access or use the Site for any purpose other than that for which we make the Site available. The Site may not be used in connection with any commercial endeavors except those that are specifically endorsed or approved by us.
          </p>
          <p>As a user of the Site, you agree not to:</p>
          <ul class="custom-list">
            <li>Systematically retrieve data or other content from the Site to create or compile, directly or indirectly, a collection, compilation, database, or directory without written permission from us.</li>
            <li>Trick, defraud, or mislead us and other users, especially in any attempt to learn sensitive account information such as user passwords.</li>
            <li>Circumvent, disable, or otherwise interfere with security-related features of the Site.</li>
            <li>Engage in unauthorized framing of or linking to the Site.</li>
            <li>Upload or transmit (or attempt to upload or to transmit) viruses, Trojan horses, or other material that interferes with any party's uninterrupted use and enjoyment of the Site.</li>
          </ul>
        </section>

        <section id="disclaimer">
          <div class="section-badge">Section 5</div>
          <h2>Educational Content Disclaimer</h2>
          <p>
             The content, training materials, and courses provided on this platform are for educational and informational purposes only. While we strive for excellence in our curriculum, we make no guarantees regarding individual learning outcomes, certification exam results, or career advancement.
          </p>
          <div class="warning-box">
             <p><strong>Careeer Support:</strong> Our placement assistance program is designed to support your journey, but it is not a guarantee of employment. Success in the Salesforce ecosystem depends on personal effort, hands-on practice, and interview performance.</p>
          </div>
        </section>

        <section id="termination">
          <div class="section-badge">Section 6</div>
          <h2>Termination</h2>
          <p>
            These Terms of Service shall remain in full force and effect while you use the Site. WITHOUT LIMITING ANY OTHER PROVISION OF THESE TERMS OF SERVICE, WE RESERVE THE RIGHT TO, IN OUR SOLE DISCRETION AND WITHOUT NOTICE OR LIABILITY, DENY ACCESS TO AND USE OF THE SITE TO ANY PERSON FOR ANY REASON.
          </p>
          <p>
            If we terminate or suspend your account for any reason, you are prohibited from registering and creating a new account under your name, a fake or borrowed name, or the name of any third party, even if you may be acting on behalf of the third party.
          </p>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --brand-primary: #18829c;
    --brand-light: rgba(24, 130, 156, 0.08);
    --brand-border: rgba(24, 130, 156, 0.2);
    --text-main: #374151;
    --text-dark: #111827;
    --text-muted: #6b7280;
    --white: #ffffff;
    --bg-page: #f9fafb;
    --bg-card: #ffffff;
    --nav-height: 80px;
  }

  .legal-page {
    background-color: var(--bg-page);
    min-height: 100vh;
    padding-bottom: 8rem;
    scroll-behavior: smooth;
  }

  .legal-hero {
    background-color: var(--white);
    padding: 8rem 0 4rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .last-updated {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 0.5rem;
    }
  }

  .legal-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-top: -3.3rem;
    margin-bottom: -6rem;
  }

  @media (min-width: 992px) {
    .legal-container {
      grid-template-columns: 280px 1fr;
    }
  }

  /* Sticky Nav */
  .legal-nav {
    display: none;
  }

  @media (min-width: 992px) {
    .legal-nav {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
      height: fit-content;
      z-index: 10;
    }
  }

  .legal-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid #e5e7eb;
  }

  .legal-nav a {
    display: block;
    padding: 0.85rem 0 0.85rem 1.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-left: 2px solid transparent;
    margin-left: -2px;
  }

  .legal-nav a:hover {
    color: var(--brand-primary);
    background-color: var(--brand-light);
  }

  .legal-nav a.active {
    color: var(--brand-primary);
    border-left-color: var(--brand-primary);
    background: linear-gradient(to right, var(--brand-light), transparent);
  }

  /* Content */
  .legal-content {
    background: var(--bg-card);
    padding: 4rem;
    border-radius: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
  }

  @media (max-width: 768px) {
    .legal-content {
      padding: 2rem 1.25rem;
      border-radius: 1.25rem;
    }
    
    section {
        margin-bottom: 3.5rem;
    }
    
    h2 {
        font-size: 1.75rem;
    }
  }

  section {
    margin-bottom: 5rem;
    scroll-margin-top: calc(var(--nav-height) + 4rem);
  }

  section:last-child {
    margin-bottom: 0;
  }

  .section-badge {
    background: var(--brand-light);
    color: var(--brand-primary);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
    display: inline-block;
    letter-spacing: 0.05em;
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  p {
    line-height: 1.8;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .highlight-info {
    padding: 2rem;
    background-color: var(--bg-page);
    border-radius: 1.25rem;
    border-left: 4px solid var(--brand-primary);
    margin: 2rem 0;
  }

  .highlight-info p {
    margin-bottom: 0;
    font-style: italic;
    font-weight: 500;
  }

  .warning-box {
    padding: 2rem;
    background-color: rgba(245, 158, 11, 0.05);
    border-radius: 1.25rem;
    border: 1px dashed #f59e0b;
    color: #92400e;
    margin: 2rem 0;
  }

  .custom-list {
    list-style: none;
    padding: 0;
    margin-bottom: 2rem;
  }

  .custom-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .custom-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 10px;
    height: 10px;
    background: var(--brand-primary);
    border-radius: 3px;
    opacity: 0.8;
  }

  .text-center { text-align: center; }

  /* Dark Mode support */
  :global(.dark) {
    --bg-page: #0f172a;
    --white: #1e293b;
    --bg-card: #1e293b;
    --text-dark: #f8fafc;
    --text-main: #cbd5e1;
    --text-muted: #94a3b8;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = Array.from(document.querySelectorAll('section[id]')) as HTMLElement[];
    const navLinks = document.querySelectorAll('.legal-nav a');
    
    if (!sections.length || !navLinks.length) return;

    const updateActiveLink = () => {
      const scrollPos = window.scrollY + 180;
      let activeId = sections[0].id;
      
      for (const section of sections) {
        if (scrollPos >= section.offsetTop) {
          activeId = section.id;
        }
      }

      navLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${activeId}`);
      });
    };

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();

    navLinks.forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const targetId = this.getAttribute('href');
        if (!targetId || !targetId.startsWith('#')) return;
        
        e.preventDefault();
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 120;
          const top = (targetElement as HTMLElement).offsetTop - offset;
          
          window.scrollTo({
            top: top,
            behavior: 'smooth'
          });
          
          history.pushState(null, '', targetId);
        }
      });
    });
  });
</script>
